{
  "name": "discord",
  "label": "Discord",
  "kind": "bridge",
  "version": "1.0.0",
  "description": "Discord gateway adapter \u2014 connects via discord.js WebSocket.",
  "requiredEnv": [
    "DISCORD_BOT_TOKEN"
  ],
  "secretEnv": [
    "DISCORD_BOT_TOKEN"
  ],
  "optionalEnv": [
