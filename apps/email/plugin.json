{
  "name": "email",
  "label": "Email (Resend)",
  "kind": "webhook",
  "version": "1.0.0",
  "description": "Resend webhook verification and authenticated durable handoff to the product relay; the host delivers replies.",
  "requiredEnv": [
    "RESEND_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "EMAIL_ALLOWED_SENDERS",
    "SMOLPAWS_RELAY_SERVER_URL",
    "SMOLPAWS_RELAY_SERVER_API_KEY"
  ],
  "secretEnv": [
    "RESEND_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "EMAIL_ALLOWED_SENDERS",
    "SMOLPAWS_RELAY_SERVER_API_KEY"
  ],
  "optionalEnv": []
}
