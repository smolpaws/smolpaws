    "type": "git",
    "url": "git+https://github.com/smolpaws/openhands-agent.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "_smolpawsProvenance": {
    "source": "github.com/smolpaws/openhands-agent",
