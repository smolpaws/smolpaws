{
  "name": "smolpaws",
  "version": "1.0.0",
  "description": "Your smart cat. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "./scripts/run-local-smolpaws.sh npm run start:node",
    "start:node": "node dist/index.js",
    "dev": "./scripts/run-local-smolpaws.sh npm run dev:start",
    "dev:start": "tsx src/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "discord:start": "bash ./scripts/run-local-bridge.sh discord",
    "discord:dev": "./scripts/run-local-smolpaws.sh npm --prefix apps/discord run dev",
    "discord:test": "npm --prefix apps/discord run test",
    "discord:typecheck": "npm --prefix apps/discord run typecheck",
    "slack:relay:local": "bash ./scripts/run-local-slack-relay.sh",
    "bridge:start": "bash ./scripts/run-local-bridge.sh",
    "bridge:launchagent:install": "bash ./scripts/install-bridge-launchagent.sh",
    "bridge:launchagent:remove": "bash ./scripts/remove-bridge-launchagent.sh",
    "whatsapp:start": "bash ./scripts/run-local-bridge.sh whatsapp",
    "whatsapp:auth": "./scripts/run-local-smolpaws.sh npm --prefix apps/whatsapp run auth --",
    "whatsapp:test": "npm --prefix apps/whatsapp run test",
    "whatsapp:typecheck": "npm --prefix apps/whatsapp run typecheck",
    "shared:test": "tsx --test src/shared/*.test.ts",
    "github:dev": "npm --prefix apps/github run dev",
    "github:deploy": "npm --prefix apps/github run deploy",
    "github:test": "npm --prefix apps/github run test",
    "github:test:agent-server-contract": "npm --prefix apps/github run test:agent-server-contract",
    "email:dev": "npm --prefix apps/email run dev",
    "email:deploy": "npm --prefix apps/email run deploy",
    "email:test": "npm --prefix apps/email run test",
    "agent-server:test": "npm --prefix apps/agent-server run test",
    "coordinator:test": "tsx --test src/coordinator/*.test.ts",
    "runner:dev": "npm --prefix apps/agent-server run dev",
    "runner:start": "npm --prefix apps/agent-server run start",
    "runner:local": "./scripts/run-local-agent-server.sh",
    "smolpaws:launchagent:install": "./scripts/install-local-smolpaws-launchagent.sh",
    "smolpaws:launchagent:remove": "./scripts/remove-local-smolpaws-launchagent.sh",
    "heartbeat:local": "./scripts/run-local-heartbeat.sh",
    "heartbeat:launchagent:install": "./scripts/install-local-heartbeat-launchagent.sh",
    "heartbeat:launchagent:remove": "./scripts/remove-local-heartbeat-launchagent.sh",
    "paws:launchagent:install": "./scripts/install-local-paws-launchagent.sh",
    "paws:launchagent:remove": "./scripts/remove-local-paws-launchagent.sh",
    "paws:on": "./scripts/paws-on.sh",
    "paws:off": "./scripts/paws-off.sh",
    "runner:image:build": "container build -t smolpaws-runner:latest apps/agent-server",
    "openapi:generate": "./scripts/generate-openapi.sh",
    "typecheck": "tsc --noEmit",
    "whatsapp:handoff": "./scripts/run-local-smolpaws.sh node --import tsx/esm apps/whatsapp/src/handoff.ts",
    "relay-server:start": "./scripts/run-local-smolpaws.sh node --import tsx/esm apps/relay-server/src/index.ts",
    "relay-server:typecheck": "tsc -p apps/relay-server/tsconfig.json",
    "relay-server:test": "tsx --test apps/relay-server/src/*.test.ts"
  },
  "dependencies": {
    "@smolpaws/agent-sdk": "^0.10.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "mammoth": "^1.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@smolpaws/openhands-agent-server": "file:packages/openhands-agent-server",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
