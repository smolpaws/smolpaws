{
  "name": "@smolpaws/openhands-agent-server",
  "version": "0.1.0",
  "description": "Idiomatic TypeScript transpilation of the OpenHands Python agent-server package.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "ci": "npm run test:upstream-provenance && npm run openapi && npm run test:openapi-parity && npm test && npm run smoke:local && npm run test:coverage && npm run typecheck && npm run typecheck:examples && npm run lint && npm run build && npm run test:pack",
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.json",
    "lint": "eslint ./src ./examples",
    "manual:llm": "tsx examples/manual-llm-smoke.ts",
    "manual:llm:gemini": "tsx examples/manual-llm-smoke-gemini.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "test:upstream-provenance": "tsx scripts/check-upstream-provenance.ts",
    "test:openapi-parity": "tsx scripts/check-openapi-parity.ts",
    "test:route-parity": "npm run test:openapi-parity",
    "test:pack": "./scripts/pack-consumer-smoke.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:local": "tsx examples/local-endpoint-smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@smolpaws/openhands-agent": "file:vendor/openhands-agent",
    "fastify": "^5.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "globals": "^15.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "bundledDependencies": [
    "@smolpaws/openhands-agent"
  ]
}
